rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document: only the owner (authenticated with their own uid)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Income entries — private to the signed-in owner
      match /incomes/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Expense entries — private to the signed-in owner
      match /expenses/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
